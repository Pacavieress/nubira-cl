# ==============================
# Plantilla de variables de entorno (sin secretos reales).
# Copiar a .env y completar los valores. NO commitear el .env real.
# ==============================

# ==============================
# BASE DE DATOS
# ==============================
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=

# ==============================
# SMTP (Hostinger)
# ==============================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER_NOREPLY=no-reply@nubira.cl
SMTP_PASS_NOREPLY=
SMTP_USER_CONTACTO=contacto@nubira.cl
SMTP_PASS_CONTACTO=

# ==============================
# DAILY.CO (VIDEO LLAMADAS)
# ==============================
DAILY_API_KEY=

# ==============================
# GOOGLE GEMINI API
# ==============================
GEMINI_API_KEY=

# ==============================
# MERCADO PAGO (PRODUCCIÓN)
# ==============================
MP_ACCESS_TOKEN=
MP_ACCESS_TOKEN_OPORTUNIDADES=

# ==============================
# HMAC SECRET (firma de URLs)
# ==============================
NUBIRA_HMAC_SECRET=

# ==============================
# UNSUBSCRIBE SECRET (tokens List-Unsubscribe)
# Generar con: php -r "echo bin2hex(random_bytes(32));"
# ==============================
UNSUB_SECRET=
