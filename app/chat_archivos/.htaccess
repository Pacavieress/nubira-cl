# ============================================
# NUBIRA 2.0 — Adjuntos de chat (BLINDAJE TOTAL)
# Los archivos NO se sirven por URL directa.
# Solo /app/ver_archivo.php puede entregarlos.
# ============================================

# 1. Bloquear TODO acceso directo a cualquier archivo de esta carpeta
Require all denied

# 2. Defensa redundante por si Require no se aplica
<FilesMatch ".*">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# 3. Anular cualquier handler de PHP/scripts
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar .py .pl .cgi .sh .asp .aspx .jsp
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phar .py .pl .cgi .sh .asp .aspx .jsp
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .phar

# 4. Sin listado de directorio, sin ejecución CGI, sin seguir symlinks
Options -Indexes -ExecCGI -FollowSymLinks

# 5. Romper cualquier rewrite heredado del .htaccess raíz
RewriteEngine Off