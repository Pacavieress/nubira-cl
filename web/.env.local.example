# API_URL es server-only (SIN prefijo NEXT_PUBLIC_) a propósito: la página de listado
# usa un Server Component, el fetch corre en el servidor de Next, nunca en el navegador
# — por eso no hace falta exponerlo al bundle de cliente, y por eso tampoco aplica CORS.
#
# Hoy apunta a la API local (server/) mientras validamos el patrón. El VPS ya tiene la
# API desplegada y corriendo — cuando se decida apuntar ahí, es cambiar este único valor,
# nada de código.
API_URL=http://localhost:4000

# El detalle de un servicio todavía no existe como página propia en web/ (fuera de
# alcance de esta fase) — las cards enlazan al sitio PHP real mientras tanto, mismo
# patrón de URL que url_servicio() en PHP (/servicios/{slug}-{id}).
PHP_SITE_URL=http://nubira.local

# Número de proxies de confianza delante de Next (los que agregan la IP real del visitante
# al final de X-Forwarded-For). 0 en local. Si no se define en producción, el límite de 3
# intentos por IP de /api/cuenta-express es global para todos los visitantes.
TRUSTED_PROXY_HOPS=0
