# Credenciales y configuración sensible
.env
env
# app/config.php
app/conexion.php

# Base de datos local
# /sql/ = dumps con datos personales -> nunca trackear
# /db/  = ignorada salvo /db/migrations/ (las migraciones SI se trackean)
/sql/
/db/*
!/db/migrations/

# Logs
*.log
*.txt
!robots.txt
# Excepción: licencia de fuentes embebidas (OFL exige incluirla)
!app/assets/fonts/OFL.txt
app/log_correos.txt
app/logs/
logs/
app/cron/logs/

# Archivos subidos por usuarios
/upload/
/upload_mini_aula/
app/chat_archivos/
app/uploads_entregas/
app/cache_ia/
app/cache_nav/

# Dependencias (se reinstalan con composer)
/vendor/

# Backups locales
backup_*/
backups/

# Archivos temporales y de sistema
*.tmp
Thumbs.db
.DS_Store
app/sala_activa_*.txt
app/_logger_sonda.txt
.claude/
