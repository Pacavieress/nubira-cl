# Copiar a .env y ajustar. Este server/.env es independiente del .env de PHP en la raíz
# del repo (formato distinto, cargado por dotenv en vez de app/env_loader.php) aunque en
# Fase 1-2 apunte a la MISMA base de datos local que usa app/conexion.php.
#
# NUNCA apuntar esto a producción sin confirmación explícita — ver Fase 4 del plan de migración.

PORT=4000
NODE_ENV=development

# Orígenes permitidos para CORS, separados por coma (ej. http://localhost:3000,https://nubira.cl).
# Vacío = deniega todo origin cross-site por defecto. No poner "*" salvo que sepas por qué.
CORS_ORIGIN=

# Base para resolver imágenes (/upload/..., /app/perfil/fotos/...) que devuelve la API.
# Local: http://nubira.local — Producción: https://nubira.cl
ASSETS_BASE_URL=http://nubira.local

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=u516405553_u516405553_Nub
