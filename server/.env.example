# Copiar a .env y ajustar. Este server/.env es independiente del .env de PHP en la raíz
# del repo (formato distinto, cargado por dotenv en vez de app/env_loader.php) aunque en
# Fase 1-2 apunte a la MISMA base de datos local que usa app/conexion.php.
#
# NUNCA apuntar esto a producción sin confirmación explícita — ver Fase 4 del plan de migración.

PORT=4000
NODE_ENV=development

# Orígenes permitidos para CORS, separados por coma (ej. http://localhost:3000,https://nubira.cl).
# Vacío = deniega todo origin cross-site por defecto. No poner "*" salvo que sepas por qué.
CORS_ORIGIN=

# Base para resolver imágenes (/upload/..., /app/perfil/fotos/...) que devuelve la API.
# Local: http://nubira.local — Producción: https://nubira.cl
ASSETS_BASE_URL=http://nubira.local

# Directorio real donde escribir archivos subidos (apuntes, previews) — el mismo /upload/
# que sirve el sitio PHP. Opcional: por defecto resuelve a <repo>/upload.
# UPLOAD_DIR=C:/nubira/upload

# Directorio real de adjuntos de chat (distinto de UPLOAD_DIR — vive dentro de app/).
# Opcional: por defecto resuelve a <repo>/app/chat_archivos.
# CHAT_ARCHIVOS_DIR=C:/nubira/app/chat_archivos

# Directorio real de materiales de Mini Aula (DOCUMENT_ROOT/upload_mini_aula en el PHP real,
# es decir la raíz del repo, no app/). Opcional: por defecto resuelve a <repo>/upload_mini_aula.
# MATERIALES_AULA_DIR=C:/nubira/upload_mini_aula

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=u516405553_u516405553_Nub

# MercadoPago (Checkpoint 2 — Pago). Token real de producción (mismo que usa app/.env del
# sitio PHP, live_mode=true) — NUNCA lo pegues acá en texto plano fuera de tu .env local.
MP_ACCESS_TOKEN=

# Origen público donde vive web/ (Next.js) — usado para construir las back_urls que
# MercadoPago pone en la barra de direcciones del comprador tras pagar.
# Local: http://localhost:3000 — Producción: el dominio real una vez que web/ esté desplegado.
WEB_BASE_URL=http://localhost:3000

# Origen público donde vive ESTA API — usado para construir notification_url (el webhook
# que MercadoPago llama server-to-server). localhost NO es alcanzable desde MercadoPago en
# desarrollo local: el webhook solo se puede probar de verdad una vez deployado, o vía un
# túnel (ngrok/similar) apuntado acá temporalmente.
API_PUBLIC_URL=http://localhost:4000

# Daily.co (Grupo Mini Aula, Fase 4 — video). Mismo valor real que usa app/.env del sitio
# PHP (DAILY_API_KEY) — NUNCA lo pegues acá en texto plano fuera de tu .env local. Opcional:
# si falta, la creación de sala (best-effort, igual que el PHP real) simplemente falla y se
# ignora — no bloquea el resto de la API.
DAILY_API_KEY=

# SMTP (Hostinger) — cliente de correo mínimo, puerto de app/correo.php (mismo host/puerto/
# credenciales reales que usa el sitio PHP). Primer consumidor: Admin Retiros (correo de
# aprobado/rechazado al tutor), pensado para ser reutilizable por futuras piezas. Opcional:
# si falta, el envío de correo falla y se registra el error — no bloquea el resto de la API.
SMTP_PASS_NOREPLY=
SMTP_PASS_CONTACTO=

# Clave HMAC que firma los links de /unsubscribe (app/config.php:40, UNSUB_SECRET). Ni el
# .env de PHP ni este la tienen seteada hoy en local (ambos caen al fallback '' del PHP
# real) — si se define en producción, hay que copiar el mismo valor acá o los links
# generados por un lado no van a verificar contra el otro.
UNSUB_SECRET=
